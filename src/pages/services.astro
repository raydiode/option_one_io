---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/base';
import { cta } from '../brand.config';

const services = [
  {
    name: 'Design',
    href: '/services/design',
    body: [
      'What should exist, how it works, and in what order. Architecture, structure and sequence, with the decisions that have to be taken before anything is committed.',
    ],
  },
  {
    name: 'Build',
    href: '/services/build',
    body: [
      'Make it. Not a specification handed to someone else, but the working thing: systems, procedures, automation, and people trained to run it.',
    ],
  },
  {
    name: 'Integrate',
    href: '/services/integrate',
    body: [
      'Put it into the organisation so it holds. It runs without us, and it depends on no one person.',
    ],
  },
  {
    name: 'Communicate',
    href: '/services/communicate',
    body: [
      'The record and the telling. Film, sound and the written word, for work that has to be understood by people who were not there.',
    ],
  },
];

const description =
  'Design, build, integrate and communicate. Four capabilities, applied to undertakings that do not fit an existing firm. Global operations and delivery, from London.';
---
<BaseLayout
  title="Services — Design, Build, Integrate, Communicate"
  breadcrumb="Services"
  description={description}>

  <section class="page-head">
    <div class="wrap sect">
      <p class="sec-mark mono">Services</p>
      <div class="sect-body">
        <h1>Four capabilities, one standard.</h1>
        <p class="lede">Most of what we are asked to do has not been done before by the
        people asking. The undertaking changes every time. What does not change is the
        order the work is taken in, or <a href={withBase('/about')}>the standard it is
        held to</a>.</p>
      </div>
    </div>
  </section>

  <section class="panel">
    <div class="wrap sect">
      <p class="sec-mark mono">What we do</p>
      <div class="sect-body">
        {services.map((s) => (
          <a class="rowlink" href={withBase(s.href)}><div class="row reveal">
            <div class="body">
              <h3>{s.name}</h3>
              {s.body.map((p) => <p>{p}</p>)}
            </div>
            <span class="go">View →</span>
          </div></a>
        ))}
      </div>
    </div>
  </section>

  <section class="contact panel">
    <div class="wrap sect">
      <p class="sec-mark mono reveal">Next</p>
      <div class="sect-body">
        <h2 class="reveal">Commissioned together, or one at a time.</h2>
        <div class="prose reveal" style="margin-bottom:var(--sp-l)">
          <p>Scope is set against the undertaking, not against a package.</p>
        </div>
        <a class="btn btn-ghost reveal" href={withBase(cta.href)}>{cta.label}</a>
      </div>
    </div>
  </section>
</BaseLayout>
